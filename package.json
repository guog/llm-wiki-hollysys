{
  "name": "llm-wiki-hollysys",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "wiki": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx src/cli.ts eval",
    "eval:promptfoo": "PROMPTFOO_DISABLE_TELEMETRY=1 promptfoo eval -c evals/promptfooconfig.offline.yaml --no-share",
    "eval:live": "PROMPTFOO_DISABLE_TELEMETRY=1 promptfoo eval -c evals/promptfooconfig.yaml --env-file .env --no-share",
    "validate:skill": "bash scripts/validate-skill.sh",
    "verify": "npm run typecheck && npm run build && npm test && npm run eval && npm run eval:promptfoo && npm run validate:skill"
  },
  "dependencies": {
    "@langchain/textsplitters": "1.0.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "commander": "15.0.0",
    "csv-parse": "6.1.0",
    "diff": "9.0.0",
    "dotenv": "17.4.2",
    "fast-glob": "3.3.3",
    "gray-matter": "4.0.3",
    "mineru-document-explorer": "1.0.9",
    "node-html-markdown": "2.0.0",
    "openai": "6.46.0",
    "p-retry": "8.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "promptfoo": "0.121.18",
    "tsx": "4.23.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
